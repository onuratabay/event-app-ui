{
  "expo": {
    "name": "EwentApp",
    "slug": "event-app",
    "version": "3.0.0",
    "scheme": "eventapp",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.eventapp.community",
      "icon": "./assets/brand/ewentapp-logo.png"
    },
    "android": {
      "package": "com.eventapp.community",
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "icon": "./assets/brand/ewentapp-logo.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/ewentapp-logo.png",
        "backgroundColor": "#00000000"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "buildArchs": ["armeabi-v7a", "arm64-v8a"]
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil ve etkinlik fotoğrafını seçmek için fotoğraflarına erişim gerekiyor.",
          "cameraPermission": "Profil ve etkinlik fotoğrafı çekmek için kamera izni gerekiyor.",
          "microphonePermission": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Referans isteyebileceğin üyeleri bulmak için paylaşmayı seçtiğin kişilere erişim gerekiyor."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yakınındaki etkinlikleri ve bulunduğun şehre uygun önerileri göstermek için konumuna erişim gerekiyor."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6978ff"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0e1430",
          "dark": {
            "backgroundColor": "#0e1430"
          }
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "light",
          "hidden": false
        }
      ],
      "./plugins/withAutofillHighlight.cjs"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/brand/ewentapp-logo.png",
    "extra": {
      "eas": {
        "projectId": "afed72bb-4bc3-48d3-b104-2159faa4313b"
      }
    },
    "owner": "onuratabay",
    "backgroundColor": "#0e1430"
  }
}
